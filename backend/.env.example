# Copy to backend/.env and fill in your own local MySQL credentials.
# Never commit the filled-in .env file.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=smart_campus_placement
DB_USER=campus_app
DB_PASSWORD=

# Comma separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. If DB_PASSWORD is left empty, the MySQL client library reads the
# credentials from this option file instead, exactly like the `mysql` CLI.
# Keep the file at mode 600 and never commit it.
DB_OPTION_FILE=~/.my.cnf
